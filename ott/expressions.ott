% Haskell 2010 (revised): Chapter 3, Expressions.
%
% Abstract syntax of expressions and the translation identities that
% Chapter 3 states in its "Translation" boxes, together with the formal
% semantics of case expressions (Figures 3.1-3.3).  The precedence
% levels of the concrete grammar (exp / infixexp / lexp / fexp / aexp)
% are collapsed into a single nonterminal: they only matter for
% parsing, which Chapter 10 specifies separately (layout, fixity
% resolution).

embed {{ typst-preamble
// Report style: keywords and symbols as code, and translation
// identities (rules) shown as equations with their side conditions.
// Pass `show-name: false` to a rule, as in `ottdruleif(show-name: false)`,
// for a centred equation without the rule name, followed by its side
// conditions.  In paged output the equation is inline math, so that a long
// one wraps at its relations instead of overflowing; HTML export, which
// ignores grid and align, gets a display equation.
#let ottkw(x) = math.mono(x)
// -> is a relation, so that a long rule can wrap after it.
#let ottsym(x) = if x == "->" { math.class("relation", math.mono(x)) } else { math.mono(x) }
#let ottdrule(premises: (), conclusion: none, name: none, com: none, ..args) = {
  let side = if premises.len() == 0 { [] } else {
    [where #premises.join([, ])]
  }
  if args.named().at("show-name", default: true) {
    grid(columns: (1fr, auto), column-gutter: 1em, align: (left, right),
      [#conclusion #h(1em) #side], text(size: 0.8em, name))
  } else {
    context if target() == "html" {
      math.equation(block: true, numbering: none, conclusion.body)
      side
    } else {
      block(width: 100%, align(center, par(justify: false, conclusion)))
      if premises.len() > 0 { par(justify: false, side) }
    }
  }
}
#let ottusedrule(r, categories: ()) = block(spacing: 0.8em, r)
}}

metavar var, x, f, v, y ::=
  {{ com variable }} {{ lex alphanum0 }} {{ typstvar mono([[var]]) }}
metavar con, K ::=
  {{ com data constructor }} {{ lex Alphanum }} {{ typstvar mono([[con]]) }}
metavar newcon, N ::=
  {{ com newtype constructor }}
metavar varsym ::=
  {{ com operator symbol }}
metavar integer, i ::=
  {{ com integer literal }} {{ lex numeral }}
metavar float, r ::=
  {{ com floating point literal }}
metavar char, c ::=
  {{ com character literal }}
metavar string, str ::=
  {{ com string literal }}
metavar tyvar, u ::=
  {{ com type variable }} {{ lex alphanum0 }}
metavar tycls, C ::=
  {{ com type class }} {{ lex Alphanum }} {{ typstvar mono([[tycls]]) }}
metavar tycon, T ::=
  {{ com type constructor }} {{ lex Alphanum }} {{ typstvar mono([[tycon]]) }}

indexvar index, j, k, m, n ::=
  {{ com index }} {{ lex numeral }}

grammar

exp, e, b, l :: 'E_' ::=                         {{ com expression }}
  | x                               ::   :: Var        {{ com variable }}
  | K                               ::   :: Con        {{ com data constructor }}
  | N                               ::   :: NewCon     {{ com newtype constructor }}
  | lit                             ::   :: Lit        {{ com literal }}
  | ()                              ::   :: Unit       {{ com unit }}
  | []                              ::   :: Nil        {{ com empty list }}
  | e '::' t                        ::   :: Sig        {{ com expression type signature }}
  | e1 op e2                        ::   :: Infix      {{ com infix application }}
  | - e                             ::   :: Neg        {{ com prefix negation }}
  | \ p1 ... pn -> e                ::   :: Lam        {{ com lambda abstraction }}
  | let decls 'in' e                ::   :: Let        {{ com let expression }}
  | if e1 then e2 else e3           ::   :: If         {{ com conditional }}
  | case e of { alt1 ; ... ; altn } ::   :: Case       {{ com case expression }}
  | do { stmts }                    ::   :: Do         {{ com do expression }}
  | e1 e2                           ::   :: App        {{ com function application }}
  | ( e )                           :: S :: Paren      {{ com parenthesized expression }}
  | ( op )                          ::   :: Op         {{ com operator as a function }}
  | ( e1 , .... , ek )              ::   :: Tuple      {{ com tuple, $k >= 2$ }}
  | [ e1 , ... , ek ]               ::   :: List       {{ com list, $k >= 1$ }}
  | [ e1 '..' ]                     ::   :: From       {{ com arithmetic sequence }}
  | [ e1 , e2 '..' ]                ::   :: FromThen   {{ com arithmetic sequence }}
  | [ e1 '..' e3 ]                  ::   :: FromTo     {{ com arithmetic sequence }}
  | [ e1 , e2 '..' e3 ]             ::   :: FromThenTo {{ com arithmetic sequence }}
  | [ e | Q ]                       ::   :: Comp       {{ com list comprehension }}
  | ( e op )                        ::   :: LSection   {{ com left section }}
  | ( op e )                        ::   :: RSection   {{ com right section }}
  | K { bs }                        ::   :: RecCon     {{ com labeled construction }}
  | e { bs }                        ::   :: RecUpd     {{ com labeled update, at least one binding }}
  | "..."                           ::   :: FailMsg    {{ com compiler-generated error message }}
  | "No match"                      ::   :: NoMatch    {{ com the error message of a failed case }}
                                                       {{ tex \texttt{"No match"} }}
                                                       {{ typst ottsym("\"No match\"") }}
  | "Unmatched pattern"             ::   :: Unmatched  {{ com the error message of a failed pattern binding }}
                                                       {{ tex \texttt{"Unmatched pattern"} }}
                                                       {{ typst ottsym("\"Unmatched pattern\"") }}
  | "Update error"                  ::   :: UpdError   {{ com the error message of a failed update }}
                                                       {{ tex \texttt{"Update error"} }}
                                                       {{ typst ottsym("\"Update error\"") }}
  | bot                             ::   :: Bot        {{ com divergence (a semantic value) }}
                                                       {{ tex \bot }} {{ typst bot }}
  % The invisible marker @@ keeps this list form apart from e1 e2:
  % without it every application would have several parses.
  | e @@ e1 ... en                  :: M :: Apps       {{ com nested applications $e e_1 dots e_n$ }}
  | e1 : ... : ek : []              :: M :: Conses     {{ com nested applications of (:) }}

op :: 'Op_' ::=                                  {{ com binary operator }}
  | varsym                          ::   :: Sym        {{ com operator symbol }}
  | >>                              ::   :: Then       {{ com from class Monad }}
  | >>=                             ::   :: Bind       {{ com from class Monad }}
  | ==                              ::   :: Eq         {{ com from class Eq }}
  | Ratio.%                         ::   :: Ratio      {{ com from module Data.Ratio }}
  | $                               ::   :: Apply      {{ com application, from the Prelude }}
  | $!                              ::   :: StrictApply {{ com strict application, from the Prelude }}

literal, lit :: 'Lit_' ::=                       {{ com literal }}
  | i                               ::   :: Integer    {{ com integer }}
  | r                               ::   :: Float      {{ com floating point }}
  | c                               ::   :: Char       {{ com character }}
  | str                             ::   :: String     {{ com string }}

quals, Q :: 'Q_' ::=                             {{ com qualifiers }}
  | q                               ::   :: One
  | q , Q                           ::   :: Cons

qual, q :: 'Qual_' ::=                           {{ com qualifier }}
  | p <- e                          ::   :: Gen        {{ com generator }}
  | let decls                       ::   :: Let        {{ com local declaration }}
  | e                               ::   :: Guard      {{ com boolean guard }}

alt :: 'Alt_' ::=                                {{ com case alternative }}
  | p match                         ::   :: Alt

match :: 'Match_' ::=                            {{ com right-hand side of an alternative }}
  | -> e                            ::   :: Plain
  | -> e where decls                ::   :: PlainWhere
  | gdrhs1 ... gdrhsn               ::   :: Guarded
  | gdrhs1 ... gdrhsn where decls   ::   :: GuardedWhere

gdrhs :: 'GdRhs_' ::=                            {{ com guarded right-hand side }}
  | '|' gs -> e                     ::   :: GdRhs

guards, gs :: 'Guards_' ::=                      {{ com guards }}
  | g1 , ... , gn                   ::   :: Guards

guard, g :: 'Guard_' ::=                         {{ com guard }}
  | p <- e                          ::   :: Pat        {{ com pattern guard }}
  | let decls                       ::   :: Let        {{ com local declaration }}
  | e                               ::   :: Bool       {{ com boolean guard }}

stmts :: 'Stmts_' ::=                            {{ com statements }}
  | e                               ::   :: Last
  | stmt ; stmts                    ::   :: Cons

stmt :: 'Stmt_' ::=                              {{ com statement }}
  | e                               ::   :: Exp
  | p <- e                          ::   :: Bind
  | let decls                       ::   :: Let

decls :: 'Decls_' ::=                            {{ com declarations }}
  | { ds }                          ::   :: Decls

binds, ds :: 'Binds_' ::=                        {{ com sequence of declarations }}
  | d1 ; .. ; dn                    ::   :: Binds

decl, d :: 'Decl_' ::=                           {{ com declaration (only bindings and signatures) }}
  | f p1 ... pn rhs                 ::   :: Fun        {{ com function binding }}
  | p rhs                           ::   :: Pat        {{ com pattern binding }}
  | x '::' t                        ::   :: Sig        {{ com type signature }}

rhs :: 'Rhs_' ::=                                {{ com right-hand side of a binding }}
  | = e                             ::   :: Plain
  | = e where decls                 ::   :: PlainWhere
  | grhs1 ... grhsn                 ::   :: Guarded
  | grhs1 ... grhsn where decls     ::   :: GuardedWhere

grhs :: 'GRhs_' ::=                              {{ com guarded right-hand side of a binding }}
  | '|' gs = e                      ::   :: GRhs

type, t :: 'T_' ::=                              {{ com type (Section 4.1.2) }}
  | u                               ::   :: Var        {{ com type variable }}
  | T                               ::   :: Con        {{ com type constructor }}
  | ()                              ::   :: Unit       {{ com unit type }}
  | []                              ::   :: ListCon    {{ com list constructor }}
  | (->)                            ::   :: FunCon     {{ com function constructor }}
  | (,...,)                         ::   :: TupleCon   {{ com tupling constructor }}
                                                       {{ tex (,\ldots,) }}
                                                       {{ typst ottsym("(,") dots.h ottsym(",)") }}
  | t1 t2                           ::   :: App        {{ com type application }}
  | t1 -> t2                        ::   :: Fun        {{ com function type }}
  | ( t1 , .... , tk )              ::   :: Tuple      {{ com tuple type, $k >= 2$ }}
  | [ t ]                           ::   :: List       {{ com list type }}
  | ( t )                           :: S :: Paren      {{ com parenthesized type }}
  | t @@ t1 ... tn                  :: M :: Apps       {{ com nested applications $t t_1 dots t_n$ }}

context, cx :: 'Cx_' ::=                         {{ com context (Section 4.1.3) }}
  | class                           ::   :: One
  | ( class1 , .. , classn )        ::   :: Many       {{ com $n >= 0$ }}

class :: 'Class_' ::=                            {{ com class assertion }}
  | C u                             ::   :: Var
  | C ( u t1 ... tk )               ::   :: App

topdecl, td :: 'TD_' ::=                         {{ com top-level declaration (only data) }}
  | data cx => T u1 .. uk = constrs ::   :: Data       {{ com datatype declaration }}

constrs :: 'Constrs_' ::=                        {{ com constructors }}
  | constr                          ::   :: One
  | constrs1 '|' constrs2           ::   :: Alt

constr :: 'Constr_' ::=                          {{ com constructor (Section 4.2.1) }}
  | K s1 .. sn                      ::   :: Con

sty, s :: 'S_' ::=                               {{ com constructor argument type }}
  | t                               ::   :: Lazy
  | ! t                             ::   :: Strict     {{ com strict }}

fbinds, bs :: 'FBinds_' ::=                      {{ com field bindings }}
  | fbind1 , .. , fbindn            ::   :: FBinds

fbind :: 'FBind_' ::=                            {{ com field binding }}
  | x = e                           ::   :: FBind

pat, p :: 'P_' ::=                               {{ com pattern }}
  | x                               ::   :: Var        {{ com variable }}
  | _                               ::   :: Wild       {{ com wildcard }}
  | lit                             ::   :: Lit        {{ com literal }}
  | ()                              ::   :: Unit       {{ com unit pattern }}
  | K p1 .. pn                      ::   :: Con        {{ com constructor pattern }}
  | N p                             ::   :: NewCon     {{ com newtype constructor pattern }}
  | K { fpat1 , .. , fpatn }        ::   :: Rec        {{ com labeled pattern }}
  | x @ p                           ::   :: As         {{ com as pattern }}
  | ~ p                             ::   :: Lazy       {{ com irrefutable pattern }}
  | ( p )                           :: S :: Paren
  | ( p1 , .... , pn )              ::   :: Tuple      {{ com tuple pattern }}
  | [ p1 , .. , pn ]                ::   :: List       {{ com list pattern }}

fpat :: 'FPat_' ::=                              {{ com field pattern }}
  | f = p                           ::   :: FPat

% Precedence, as in the concrete grammar: application binds tighter
% than infix operators and negation; lambda, let, if and case extend as
% far to the right as possible (the "meta-rule" of Chapter 3).
parsing
  E_App left E_App
  E_Infix <= E_App
  E_Neg <= E_App
  E_Sig <= E_App
  E_Sig <= E_Infix
  E_Lam <= E_App
  E_Lam <= E_Infix
  E_Let <= E_App
  E_Let <= E_Infix
  E_If <= E_App
  E_If <= E_Infix
  E_Case <= E_App
  E_Case <= E_Infix
  E_Con <= E_RecUpd
  T_App left T_App
  T_Fun right T_Fun
  T_Fun <= T_App
  Constrs_Alt left Constrs_Alt

grammar

terminals :: 'terminals_' ::=
  | '..'                            ::   :: dotdot     {{ tex .. }} {{ typst ottsym("..") }}
  | ===                             ::   :: equiv      {{ tex = }} {{ typst = }}
  | equiv                           ::   :: bequiv     {{ tex \equiv }} {{ typst equiv }}
  | notin                           ::   :: notin      {{ tex \notin }} {{ typst in.not }}
  | <>                              ::   :: neq        {{ tex \neq }} {{ typst eq.not }}
  | fresh                           ::   :: fresh      {{ tex \textrm{fresh} }} {{ typst "fresh" }}
  | notallvars                      ::   :: notallvars {{ tex \textrm{not all variables} }}
                                                       {{ typst "not all variables" }}
  | vars                            ::   :: vars       {{ tex \mathit{vars} }} {{ typst italic("vars") }}
  | fieldpats                       ::   :: fieldpats  {{ tex \mathit{fieldpats} }} {{ typst italic("fieldpats") }}
  | @@                              ::   :: apps       {{ tex \, }} {{ typst thin }}
  | wildcards                       ::   :: wildcards  {{ tex \mathit{wildcards} }} {{ typst italic("wildcards") }}
  | apply                           ::   :: apply      {{ tex \mathit{apply} }} {{ typst italic("apply") }}
  | :=                              ::   :: defeq      {{ tex = }} {{ typst = }}
  | arrows                          ::   :: arrows     {{ tex \mathit{arrows} }} {{ typst italic("arrows") }}
  | pick                            ::   :: pick       {{ tex \mathit{pick} }} {{ typst italic("pick") }}
  % picks is pick with a default for each component: the same function.
  | picks                           ::   :: picks      {{ tex \mathit{pick} }} {{ typst italic("pick") }}
  | cons                            ::   :: cons       {{ tex \mathit{cons} }} {{ typst italic("cons") }}
  | datacons                        ::   :: datacons   {{ tex \mathit{datacons} }} {{ typst italic("datacons") }}
  | select                          ::   :: select     {{ tex \mathit{select} }} {{ typst italic("select") }}

formula :: 'formula_' ::=
  | judgement                       ::   :: judgement
  | formula1 .. formulan            ::   :: dots
  | x notin fv ( e )                :: M :: notin
    {{ com $x$ does not occur free in $e$ }}
    {{ tex [[x]] \notin \mathit{fv}([[e]]) }}
    {{ typst [[x]] in.not italic("fv")([[e]]) }}
  | vars ( p ) inter fv ( e ) = empty :: M :: disjoint
    {{ com no variable in $p$ appears free in $e$ }}
    {{ tex \mathit{vars}([[p]]) \cap \mathit{fv}([[e]]) = \emptyset }}
    {{ typst italic("vars")([[p]]) inter italic("fv")([[e]]) = emptyset }}
  | x1 , .. , xn fresh              ::   :: fresh
    {{ com new variables }}
  | { x1 , .. , xn } = vars ( p )   ::   :: vars
    {{ com all the variables in $p$ }}
  | p1 .. pn notallvars             ::   :: notallvars
    {{ com at least one of the patterns is not a variable }}
  | K <> K'                         ::   :: neq
    {{ com distinct constructors }}
  | p1 .. pn = fieldpats ( K , f , p ) ::   :: fieldpats
    {{ com $p_i$ is $p$ if $f$ labels the $i$th component of $K$, and $\_$ otherwise }}
  | p1 .. pn = wildcards ( K )      ::   :: wildcards
    {{ com one $\_$ for each component of $K$ }}
  | i1 / i2 = r                     ::   :: ratio
    {{ com the value of $[[r]]$ is $[[i1]] / [[i2]]$ }}
  | td                              ::   :: decl
    {{ com the declaration $[[td]]$ is in scope }}
  | op = apply ( s )                ::   :: apply
    {{ com $[[op]]$ is strict application if $[[s]]$ is a strict type, and application otherwise }}
  | e := e'                         ::   :: def
    {{ com $[[e]]$ stands for $[[e']]$ }}
  | match = arrows ( rhs )          ::   :: arrows
    {{ com $[[match]]$ is $[[rhs]]$ with each $=$ written $->$ }}
  | e = select ( K , f , y )        ::   :: select
    {{ com $[[e]]$ is $[[y]]$ if $[[f]]$ labels a component of $[[K]]$, and undefined otherwise }}
  | { K1 , .. , Kn } = datacons ( f ) ::   :: datacons
    {{ com the constructors of the datatype with field label $f$ }}
  | { K1 , .. , Kn } = cons ( bs )  ::   :: cons
    {{ com the constructors that have all the labels bound in $[[bs]]$ }}
  | e1 .. ek = pick ( K , bs , e )  ::   :: pick
    {{ com $e_i$ is $e'$ if $f$ labels the $i$th component of $K$ and $f = e'$ is in $[[bs]]$, and $e$ otherwise }}
  | e1 .. ek = picks ( K , bs , x1 .. xm ) ::   :: picks
    {{ com $e_i$ is $e'$ if $f$ labels the $i$th component of $K$ and $f = e'$ is in $[[bs]]$, and $x_i$ otherwise }}

defns
Jtrans :: '' ::=

defn
e1 === e2 :: :: equiv :: '' {{ com $[[e1]]$ translates to $[[e2]]$ }} by

% Section 3.2, Variables, Constructors, Operators, and Literals

  ------------------------ :: integer
  i === fromInteger i

  i1 / i2 = r
  ------------------------ :: float
  r === fromRational ( i1 Ratio.% i2 )

% Section 3.3, Curried Applications and Lambda Abstractions

  x1 , ... , xn fresh
  ------------------------------------------------------------------ :: lambda
  \ p1 ... pn -> e === \ x1 ... xn -> case ( x1 , ... , xn ) of { ( p1 , ... , pn ) -> e }

% Section 3.4, Operator Applications

  ------------------------ :: infix
  e1 op e2 === ( op ) e1 e2

  ------------------------ :: negation
  - e === negate ( e )

% Section 3.5, Sections

  x notin fv ( e )
  ------------------------ :: right_section
  ( op e ) === \ x -> x op e

  x notin fv ( e )
  ------------------------ :: left_section
  ( e op ) === \ x -> e op x

% Section 3.6, Conditionals

  ------------------------------------------------------------- :: if
  if e1 then e2 else e3 === case e1 of { True -> e2 ; False -> e3 }

% Section 3.7, Lists

  -------------------------------- :: list
  [ e1 , ... , ek ] === e1 : ... : ek : []

% Section 3.9, Unit Expressions and Parenthesized Expressions

  ------------------------ :: paren
  ( e ) === e

% Section 3.10, Arithmetic Sequences

  --------------------------------- :: from
  [ e1 .. ] === enumFrom e1

  --------------------------------- :: from_then
  [ e1 , e2 .. ] === enumFromThen e1 e2

  --------------------------------- :: from_to
  [ e1 .. e3 ] === enumFromTo e1 e3

  --------------------------------- :: from_then_to
  [ e1 , e2 .. e3 ] === enumFromThenTo e1 e2 e3

% Section 3.11, List Comprehensions

  --------------------------------- :: comp_true
  [ e | True ] === [ e ]

  --------------------------------- :: comp_one
  [ e | q ] === [ e | q , True ]

  --------------------------------- :: comp_guard
  [ e | b , Q ] === if b then [ e | Q ] else []

  ok fresh
  ------------------------------------------------------------------ :: comp_gen
  [ e | p <- l , Q ] === let { ok p = [ e | Q ] ; ok _ = [] } in concatMap ok l

  --------------------------------- :: comp_let
  [ e | let decls , Q ] === let decls in [ e | Q ]

% Section 3.12, Let Expressions.  The declarations have already been
% translated to pattern bindings (Section 4.4.3).

  ------------------------------------------------------------------ :: let_tuple
  let { p1 = e1 ; ... ; pn = en } in e0 === let { ( ~ p1 , ... , ~ pn ) = ( e1 , ... , en ) } in e0

  vars ( p ) inter fv ( e1 ) = empty
  ------------------------------------------------------------------ :: let_case
  let { p = e1 } in e0 === case e1 of { ~ p -> e0 }

  ------------------------------------------------------------------ :: let_fix
  let { p = e1 } in e0 === let { p = fix ( \ ~ p -> e1 ) } in e0

% Section 3.14, Do Expressions

  --------------------------------- :: do_last
  do { e } === e

  --------------------------------- :: do_exp
  do { e ; stmts } === e >> do { stmts }

  ok fresh
  ------------------------------------------------------------------ :: do_bind
  do { p <- e ; stmts } === let { ok p = do { stmts } ; ok _ = fail "..." } in e >>= ok

  --------------------------------- :: do_let
  do { let decls ; stmts } === let decls in do { stmts }

% Section 3.15.1, Field Selection.  A field label f is a selector
% function.  The patterns of the i-th alternative are p_i_1 .. p_i_ki,
% where ki is the arity of Ki.

  { K1 , ... , Kn } = datacons ( f )
  p_1_1 ... p_1_k1 = fieldpats ( K1 , f , y ) ... p_n_1 ... p_n_kn = fieldpats ( Kn , f , y )
  e1 = select ( K1 , f , y ) ... en = select ( Kn , f , y )
  ------------------------------------------------------------------ :: select
  f x === case x of { K1 p_1_1 ... p_1_k1 -> e1 ; ... ; Kn p_n_1 ... p_n_kn -> en }

% Section 3.15.2, Construction Using Field Labels

  e1 ... ek = pick ( K , bs , undefined )
  ------------------------------------------------------------------ :: rec_con
  K { bs } === K @@ e1 ... ek

% Section 3.15.3, Updates Using Field Labels.  ki is the arity of Ki.

  { K1 , ... , Kj } = cons ( bs )
  e_1_1 ... e_1_k1 = picks ( K1 , bs , v_1 ... v_k1 ) ... e_j_1 ... e_j_kj = picks ( Kj , bs , v_1 ... v_kj )
  ------------------------------------------------------------------ :: rec_upd
  e { bs } === case e of { K1 v_1 ... v_k1 -> K1 @@ e_1_1 ... e_1_k1 ; ... ; Kj v_1 ... v_kj -> Kj @@ e_j_1 ... e_j_kj ; _ -> error "Update error" }

% Section 3.16, Expression Type-Signatures

  v fresh
  ------------------------------------------------------------------ :: sig
  e :: t === let { v :: t ; v = e } in v

% Section 4.2.1, Strictness Flags.  A declaration of the form
% data cx => T u1 .. uk = ... | K s1 ... sn | ... replaces every
% occurrence of K in an expression; e_n is the left-nested application
% (((K op1 x1) op2 x2) ...) opn xn.

  data cx => T u1 .. uk = constrs1 | K s1 ... sn | constrs2
  x1 , ... , xn fresh
  op1 = apply ( s1 ) ... opn = apply ( sn )
  e_0 := K
  e_1 := ( e_0 op1 x1 ) ... e_n := ( e_n-1 opn xn )
  ------------------------------------------------------------------ :: strict_con
  K === \ x1 ... xn -> e_n

% Section 3.17.3, Formal Semantics of Pattern Matching (Figures 3.1-3.3).
%
% The report writes rules (b), (c), (g) and (s) with nested ellipses
% ("case ... of { ...; _ -> ... case ... }"), which Ott dot forms
% cannot express.  They are restated here as one-step identities that
% unfold to the same nested form: (b) and (c) peel off one alternative
% or guarded right-hand side at a time, and (g) uses pattern guards,
% which (s) and (t) then turn into the report's nested cases.

% Figure 3.1

  v fresh
  ------------------------------------------------------------------ :: case_a
  case e of { alt1 ; ... ; altn } === ( \ v -> case v of { alt1 ; ... ; altn } ) e

  ------------------------------------------------------------------ :: case_b
  case v of { p match ; alt1 ; ... ; altn } === case v of { p match ; _ -> case v of { alt1 ; ... ; altn } }

  ------------------------------------------------------------------ :: case_b_last
  case v of { p match } === case v of { p match ; _ -> error "No match" }

  ------------------------------------------------------------------ :: case_b_true
  case v of { p -> e where decls ; _ -> e' } === case v of { p | True -> e where decls ; _ -> e' }

  y fresh
  ------------------------------------------------------------------ :: case_c
  case v of { p | gs1 -> e1 ... | gsn -> en where decls ; _ -> e' } === case e' of { y -> case v of { p -> let decls in case () of { () | gs1 -> e1 ... | gsn -> en ; _ -> y } ; _ -> y } }

  ------------------------------------------------------------------ :: case_c_next
  case () of { () | gs -> e | gs1 -> e1 ... | gsn -> en ; _ -> e' } === case () of { () | gs -> e ; _ -> case () of { () | gs1 -> e1 ... | gsn -> en ; _ -> e' } }

  { x1 , ... , xn } = vars ( p )
  ------------------------------------------------------------------ :: case_d
  case v of { ~ p -> e ; _ -> e' } === ( \ x1 ... xn -> e ) @@ ( case v of { p -> x1 } ) ... ( case v of { p -> xn } )

  ------------------------------------------------------------------ :: case_e
  case v of { x @ p -> e ; _ -> e' } === case v of { p -> ( \ x -> e ) v ; _ -> e' }

  ------------------------------------------------------------------ :: case_f
  case v of { _ -> e ; _ -> e' } === e

% Figure 3.2

  p1 ... pn notallvars
  x1 , ... , xn fresh
  ------------------------------------------------------------------ :: case_g
  case v of { K p1 ... pn -> e ; _ -> e' } === case v of { K x1 ... xn -> case () of { () | p1 <- x1 , ... , pn <- xn -> e ; _ -> e' } ; _ -> e' }

  ------------------------------------------------------------------ :: case_h
  case v of { lit -> e ; _ -> e' } === if ( v == lit ) then e else e'

  ------------------------------------------------------------------ :: case_i
  case v of { x -> e ; _ -> e' } === case v of { x -> e }

  ------------------------------------------------------------------ :: case_j
  case v of { x -> e } === ( \ x -> e ) v

  ------------------------------------------------------------------ :: case_k
  case ( N v ) of { N p -> e ; _ -> e' } === case v of { p -> e ; _ -> e' }

  ------------------------------------------------------------------ :: case_l
  case bot of { N p -> e ; _ -> e' } === case bot of { p -> e }

  y fresh
  ------------------------------------------------------------------ :: case_m
  case v of { K { f = p , fpat1 , ... , fpatn } -> e ; _ -> e' } === case e' of { y -> case v of { K { f = p } -> case v of { K { fpat1 , ... , fpatn } -> e ; _ -> y } ; _ -> y } }

  p1 ... pn = fieldpats ( K , f , p )
  ------------------------------------------------------------------ :: case_n
  case v of { K { f = p } -> e ; _ -> e' } === case v of { K p1 ... pn -> e ; _ -> e' }

  p1 ... pn = wildcards ( K )
  ------------------------------------------------------------------ :: case_o
  case v of { K { } -> e ; _ -> e' } === case v of { K p1 ... pn -> e ; _ -> e' }

  K <> K'
  ------------------------------------------------------------------ :: case_p
  case ( K' @@ e1 ... em ) of { K x1 ... xn -> e ; _ -> e' } === e'

  ------------------------------------------------------------------ :: case_q
  case ( K @@ e1 ... en ) of { K x1 ... xn -> e ; _ -> e' } === ( \ x1 ... xn -> e ) @@ e1 ... en

  ------------------------------------------------------------------ :: case_r
  case bot of { K x1 ... xn -> e ; _ -> e' } === bot

% Figure 3.3

  ------------------------------------------------------------------ :: case_s
  case () of { () | g , g1 , ... , gn -> e ; _ -> e' } === case () of { () | g -> case () of { () | g1 , ... , gn -> e ; _ -> e' } ; _ -> e' }

  ------------------------------------------------------------------ :: case_t
  case () of { () | p <- e0 -> e ; _ -> e' } === case e0 of { p -> e ; _ -> e' }

  ------------------------------------------------------------------ :: case_u
  case () of { () | let decls -> e ; _ -> e' } === let decls in e

  ------------------------------------------------------------------ :: case_v
  case () of { () | e0 -> e ; _ -> e' } === if e0 then e else e'

defn
rhs1 equiv rhs2 :: :: rhs :: '' {{ com $[[rhs1]]$ is shorthand for $[[rhs2]]$ }} by

% Section 4.4.3.1, Function bindings

  ------------------------------------------------------------------ :: rhs_true
  = e where decls equiv | True = e where decls

defn
ds1 equiv ds2 :: :: binds :: '' {{ com $[[ds1]]$ translates to $[[ds2]]$ }} by

% Section 4.4.3.1, Function bindings

  x1 , ... , xk fresh
  match1 = arrows ( rhs1 ) ... matchn = arrows ( rhsn )
  ------------------------------------------------------------------ :: fun_binding
  x p_1_1 ... p_1_k rhs1 ; ... ; x p_n_1 ... p_n_k rhsn equiv x = \ x1 ... xk -> case ( x1 , ... , xk ) of { ( p_1_1 , ... , p_1_k ) match1 ; ... ; ( p_n_1 , ... , p_n_k ) matchn }

% Section 4.4.3.2, Pattern bindings

  ------------------------------------------------------------------ :: pat_binding
  p | gs1 = e1 ... | gsm = em where decls equiv p = let decls in case () of { () | gs1 -> e1 ... | gsm -> em ; _ -> error "Unmatched pattern" }

defn
t1 === t2 :: :: types :: '' {{ com the type $[[t1]]$ is the type $[[t2]]$ }} by

% Section 4.1.2, Syntax of Types

  ------------------------------------------------------------------ :: fun_type
  t1 -> t2 === (->) t1 t2

  ------------------------------------------------------------------ :: tuple_type
  ( t1 , ... , tk ) === (,...,) @@ t1 ... tk

  ------------------------------------------------------------------ :: list_type
  [ t ] === [] t

  ------------------------------------------------------------------ :: paren_type
  ( t ) === t
